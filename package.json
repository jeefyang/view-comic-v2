{
    "name": "view-comic-v2",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node server/dev.mjs",
        "build": "run-s build-only build-server build-prod gen-ecosystem",
        "build:check": "run-s type-check build",
        "build-only": "vite build",
        "build-server": "vite build --ssr server/index.ts --outDir dist/server --emptyOutDir",
        "build-prod": "node scripts/build-prod.mjs",
        "gen-ecosystem": "node scripts/gen-ecosystem.mjs",
        "start": "node dist/server/prod.mjs",
        "preview": "vite preview",
        "type-check": "vue-tsc --build",
        "update": "git pull&&pnpm install&&npm run build && pm2 reload ecosystem.config.cjs",
        "delete": "pm2 delete ecosystem.config.cjs",
        "logs": "pm2 logs ecosystem.config.cjs"
    },
    "dependencies": {
        "@huolala-tech/page-spy-browser": "^2.4.0",
        "@huolala-tech/page-spy-plugin-data-harbor": "^2.4.0",
        "@huolala-tech/page-spy-plugin-rrweb": "^2.4.0",
        "@napi-rs/canvas": "0.1.100",
        "@vueuse/core": "^14.2.1",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "fast-xml-parser": "5.12.0",
        "helmet": "^8.1.0",
        "image-size": "^2.0.2",
        "nanoid": "^5.1.6",
        "node-stream-zip": "^1.15.0",
        "pdfjs-dist": "4.10.38",
        "pinia": "^3.0.4",
        "sharp": "^0.35.5",
        "vconsole": "^3.15.1",
        "vue": "^3.5.27",
        "vue-router": "^5.0.1",
        "vue3-touch-events": "^5.0.15"
    },
    "devDependencies": {
        "@tsconfig/node24": "^24.0.4",
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^24.10.9",
        "@vicons/antd": "^0.13.0",
        "@vicons/fluent": "^0.13.0",
        "@vicons/ionicons5": "^0.13.0",
        "@vicons/material": "^0.13.0",
        "@vitejs/plugin-vue": "^6.0.3",
        "@vitejs/plugin-vue-jsx": "^5.1.3",
        "@vue/tsconfig": "^0.8.1",
        "naive-ui": "^2.45.3",
        "npm-run-all2": "^8.0.4",
        "sass-embedded": "^1.97.3",
        "typescript": "~5.9.3",
        "unocss": "^66.6.0",
        "unplugin-auto-import": "^21.0.0",
        "unplugin-vue-components": "^31.0.0",
        "vfonts": "^0.0.3",
        "vite": "^7.3.1",
        "vue-tsc": "^3.2.4"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "optionalDependencies": {
        "@napi-rs/canvas-linux-x64-gnu": "0.1.100",
        "@napi-rs/canvas-win32-x64-msvc": "0.1.100"
    }
}